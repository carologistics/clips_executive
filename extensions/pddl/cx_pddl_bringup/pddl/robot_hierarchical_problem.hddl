(define (problem rcll-problem-01)
  (:domain rcll-minimal)

  (:objects
    p1 - product
    p2 - product
    p3 - product
    p4 - product
    p5 - product
	cc1 cc2 cc3 cc4 cc5 cc6 - carrier
	p1-pay1 p1-pay2 p2-pay1 p2-pay2 p2-pay3 p2-pay4 - payment
	p3-pay1 p3-pay2 p3-pay3 p3-pay4 p3-pay5 p3-pay6 - payment
	p4-pay1 p4-pay2 p4-pay3 p4-pay4 p4-pay5 p4-pay6 - payment
	p5-pay1 p5-pay2 p5-pay3 p5-pay4 p5-pay5 p5-pay6 - payment
  )

  (:htn
    :tasks (and
      ;(task0 (build-product p1))
      ;(task1 (build-product p2))
      (task2 (build-product p3))
      (task3 (build-product p4))
      ;(task4 (build-product p5))
    )
  )

  (:init
    ;; ring is unpaid initially
	(im-a-machine bs)
	(im-a-machine cs1)
	(im-a-machine cs2)
	(im-a-machine rs1)
	(im-a-machine rs2)
	(im-a-machine ss)
	(im-a-machine ds)
	(free bs input)
	(free bs output)
	(price ring-blue one)
	(price ring-orange two)
	(price ring-yellow zero)
	(price ring-green zero)
	(can-buffer cs1 cap-grey)
	(can-buffer cs2 cap-black)
	(product-complexity p1 c1)
	(product-complexity p2 c2)
	(product-complexity p3 c3)
	(product-complexity p4 c3)
	(product-complexity p5 c3)
	(payment-for-product p1-pay1 one p1)
	(payment-for-product p1-pay2 two p1)
	(payment-for-product p2-pay1 one p2)
	(payment-for-product p2-pay2 two p2)
	(payment-for-product p2-pay3 three p2)
	(payment-for-product p2-pay4 four p2)
	(payment-for-product p3-pay1 one p3)
	(payment-for-product p3-pay2 two p3)
	(payment-for-product p3-pay3 three p3)
	(payment-for-product p3-pay4 four p3)
	(payment-for-product p3-pay5 five p3)
	(payment-for-product p3-pay6 six p3)
	(payment-for-product p4-pay1 one p4)
	(payment-for-product p4-pay2 two p4)
	(payment-for-product p4-pay3 three p4)
	(payment-for-product p4-pay4 four p4)
	(payment-for-product p4-pay5 five p4)
	(payment-for-product p4-pay6 six p4)
	(payment-for-product p5-pay1 one p5)
	(payment-for-product p5-pay2 two p5)
	(payment-for-product p5-pay3 three p5)
	(payment-for-product p5-pay4 four p5)
	(payment-for-product p5-pay5 five p5)
	(payment-for-product p5-pay6 six p5)
	(c1-description p1 base-red ring-blue cap-grey)
	(c2-description p2 base-black ring-blue ring-orange cap-black)
	(c3-description p3 base-silver ring-green ring-yellow ring-blue cap-black)
	(c3-description p4 base-silver ring-yellow ring-blue ring-orange cap-grey)
	(c3-description p5 base-silver ring-blue ring-yellow ring-blue cap-grey)
	(at cc1 cs1 shelf)
	(at cc2 cs1 shelf)
	(at cc3 cs1 shelf)
	(at cc4 cs2 shelf)
	(at cc5 cs2 shelf)
	(at cc6 cs2 shelf)
	(usable bs)
	(usable rs1)
	(usable rs2)
	(usable cs1)
	(usable cs2)
	(usable ds)
	(usable cc1)
	(usable cc2)
	(usable cc3)
	(usable cc4)
	(usable cc5)
	(usable cc6)
	(free rs1 input)
	(free rs1 output)
	(free rs2 input)
	(free rs2 output)
	(free cs1 input)
	(free cs1 output)
	(free cs2 input)
	(free cs2 output)
	(free ds input)
	(step-machine base-red bs)
	(step-machine base-black bs)
	(step-machine base-silver bs)
	(step-machine ring-blue rs1)
	(step-machine ring-yellow rs1)
	(step-machine ring-orange rs2)
	(step-machine ring-green rs2)
	(step-machine cap-grey cs1)
	(step-machine cap-black cs2)
  )

)
